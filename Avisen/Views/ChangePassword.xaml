<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.ChangePassword"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    xmlns:sharpnado="http://sharpnado.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="ChangePassword"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions=".3*, .7*">
                <Image Aspect="AspectFill" Source="fondo3.png" />
                <Grid BackgroundColor="#e4e4e4" Opacity=".85" />
                <Grid ColumnDefinitions="*,*">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="150"
                        Source="logo.png" />
                </Grid>

                <!--  Contenido principal  -->
                <Grid Grid.Row="1">
                    <RoundRectangle
                        Margin="-5,-30,-5,-2"
                        CornerRadius="30,30,0,0"
                        Fill="#fdfefe" />
                    <VerticalStackLayout Spacing="20" VerticalOptions="Start">
                        <Label
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            Text="Introduce la nueva contraseña"
                            TextColor="#A3A3A4"
                            VerticalTextAlignment="Justify" />
                        <Label
                            x:Name="Message"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            LineHeight=".9"
                            Text="Crea tu cuenta!"
                            TextColor="#A3A3A4" />
                        <!--  Campo Contraseña  -->
                        <Grid Margin="0,30,0,0" ColumnDefinitions=".2*, .8*">
                            <Border
                                BackgroundColor="#f0f3f4"
                                HeightRequest="60"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 30,30,30,30"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="60">
                                <Label
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource MaterialIcon}"
                                    Text="{x:Static local:IconFont.Lock}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Border>
                            <Entry
                                x:Name="Password"
                                Grid.Column="1"
                                BackgroundColor="#fdfefe"
                                FontSize="16"
                                HeightRequest="60"
                                IsPassword="true"
                                MaxLength="20"
                                Placeholder="Contraseña"
                                TextChanged="Password_TextChanged"
                                TextColor="Black"
                                VerticalOptions="Center"
                                WidthRequest="300" />
                        </Grid>

                        <!--  Campo Contraseña 2  -->
                        <Grid Margin="0,30,0,0" ColumnDefinitions=".2*, .8*">
                            <Border
                                BackgroundColor="#f0f3f4"
                                HeightRequest="60"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 30,30,30,30"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="60">
                                <Label
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource MaterialIcon}"
                                    Text="{x:Static local:IconFont.Lock}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Border>
                            <Entry
                                x:Name="Password2"
                                Grid.Column="1"
                                BackgroundColor="#fdfefe"
                                FontSize="16"
                                HeightRequest="60"
                                IsPassword="true"
                                MaxLength="20"
                                Placeholder="Repite la Contraseña"
                                TextChanged="Password2_TextChanged"
                                TextColor="Black"
                                VerticalOptions="Center"
                                WidthRequest="300" />
                        </Grid>

                        <Grid ColumnDefinitions="*, *">
                            <Button
                                x:Name="Back"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,20,0,0"
                                BackgroundColor="#11d8cb"
                                Clicked="Back_Clicked"
                                CornerRadius="30"
                                FontSize="20"
                                HeightRequest="60"
                                Text="Cancelar"
                                TextColor="Black"
                                WidthRequest="170" />
                            <Button
                                x:Name="SendNewPassword"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,20,0,0"
                                BackgroundColor="#11d8cb"
                                Clicked="SendNewPassword_Clicked"
                                CornerRadius="30"
                                FontSize="20"
                                HeightRequest="60"
                                IsEnabled="False"
                                Text="Aceptar"
                                TextColor="Black"
                                WidthRequest="170" />
                        </Grid>

                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </ScrollView>
        <Grid
            x:Name="Overlay"
            BackgroundColor="#30000000"
            IsVisible="False">
            <sharpnado:MaterialFrame
                x:Name="Popupalert"
                CornerRadius="30"
                HeightRequest="200"
                HorizontalOptions="Center"
                MaterialBlurStyle="Light"
                MaterialTheme="AcrylicBlur"
                VerticalOptions="Center"
                WidthRequest="180">
                <VerticalStackLayout Padding="20" Spacing="15">
                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        HeightRequest="80"
                        IsRunning="False"
                        IsVisible="False"
                        WidthRequest="80"
                        Color="Black" />
                    <HorizontalStackLayout VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="17"
                            HorizontalOptions="Center"
                            Text="Cargando"
                            TextColor="Black" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </sharpnado:MaterialFrame>
        </Grid>
    </Grid>
</ContentPage>