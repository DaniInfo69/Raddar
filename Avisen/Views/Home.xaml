<ContentPage
    x:Class="Avisen.Views.Home"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    Title="Home"
    Padding="0"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions=".1*, .8*">

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="30"
            BackgroundColor="#11d8cb">
            <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                <Label
                    Grid.Column="0"
                    FontSize="Medium"
                    HorizontalOptions="Start"
                    Text="{Binding UpdateFrequency}"
                    TextColor="White" />
                <Label
                    Grid.Column="1"
                    FontSize="Medium"
                    HorizontalOptions="End"
                    Text="{Binding OfferDistance}"
                    TextColor="White" />
            </HorizontalStackLayout>
        </Grid>

        <!--  Main Content  -->
        <Grid Grid.Row="1">
            <Border
                Margin="-5,-30,-5,-2"
                Padding="20"
                BackgroundColor="#fdfefe"
                StrokeThickness="0"
                VerticalOptions="FillAndExpand">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30,30,0,0" />
                </Border.StrokeShape>

                <AbsoluteLayout>

                    <!--  Contenido principal  -->
                    <VerticalStackLayout AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                        <Grid
                            Margin="0,0,0,10"
                            ColumnDefinitions="*, Auto"
                            VerticalOptions="Center">
                            <!--  Título  -->
                            <Label
                                Grid.Column="0"
                                Padding="80,0,0,0"
                                FontAttributes="Bold"
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="Ofertas"
                                TextColor="#19535F" />

                            <!--  Botón de Filtrar  -->
                            <Button
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="#d1e7dd"
                                Clicked="OnFiltrarTapped"
                                CornerRadius="20"
                                FontSize="18"
                                HorizontalOptions="End"
                                Text="Filtrar"
                                TextColor="#19535F">

                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="MaterialIcon"
                                        Glyph="{x:Static local:IconFont.List_alt}"
                                        Size="25"
                                        Color="#19535F" />
                                </Button.ImageSource>

                            </Button>
                        </Grid>

                        <!--  Lista estilo tarjetas  -->
                        <CollectionView x:Name="OfertasList" ItemsSource="{Binding OfertasReales}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        Margin="0,0,0,10"
                                        Padding="15"
                                        BackgroundColor="#F5EBDC"
                                        BorderColor="#CCCCCC"
                                        CornerRadius="8"
                                        HasShadow="False">

                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto">

                                            <Border
                                                Grid.RowSpan="4"
                                                Grid.Column="0"
                                                Margin="0,0,15,0"
                                                HeightRequest="90"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 15"
                                                WidthRequest="90">
                                                <Image Aspect="AspectFill" Source="{Binding imagenes[0].url}">
                                                    <Image.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding imagenes.Count}"
                                                            TargetType="Image"
                                                            Value="0" />
                                                    </Image.Triggers>
                                                </Image>
                                            </Border>


                                            <!--  Nombre de la promoción  -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding Nombre}"
                                                TextColor="#19535F" />

                                            <!--  Vigencia  -->
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding VigenciaFin, StringFormat='Válido hasta {0:d}'}"
                                                TextColor="#0aa59b" />

                                            <!--  Tipo  -->
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                FontAttributes="Italic"
                                                FontSize="12"
                                                Text="{Binding Tipo}"
                                                TextColor="#19535F" />
                                        </Grid>

                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapCommand}" CommandParameter="{Binding}" />
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!--  Popup del filtro encima de todo  -->
                    <ContentView
                        x:Name="FiltroPopup"
                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All"
                        BackgroundColor="Transparent"
                        IsVisible="False"
                        ZIndex="99">
                        <Border
                            x:Name="PopupFrame"
                            Padding="20"
                            BackgroundColor="White"
                            HeightRequest="350"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 40,40,40,40"
                            VerticalOptions="Center"
                            WidthRequest="300">
                            <VerticalStackLayout Spacing="15">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="Filtrar por:"
                                    TextColor="#19535F" />

                                <Label
                                    FontSize="15"
                                    HorizontalOptions="Start"
                                    Text="Tipo de ofertas:"
                                    TextColor="#19535F" />
                                <Picker
                                    x:Name="FiltroPicker"
                                    Title="Selecciona una opción"
                                    ItemsSource="{Binding Filters}"
                                    SelectedItem="{Binding TempSelectedFilter}"
                                    TextColor="#19535F"
                                    TitleColor="Gainsboro"
                                    WidthRequest="200" />

                                <Label
                                    FontSize="15"
                                    HorizontalOptions="Start"
                                    Text="Categorías:"
                                    TextColor="#19535F" />
                                <Picker
                                    x:Name="FiltroCategoria"
                                    Title="Selecciona categoría"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    ItemsSource="{Binding Categorias}"
                                    SelectedItem="{Binding TempSelectedCategory}"
                                    TextColor="#19535F"
                                    TitleColor="Gainsboro"
                                    WidthRequest="200" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button
                                        BackgroundColor="LightGray"
                                        Command="{Binding ClearFiltersCommand}"
                                        CornerRadius="20"
                                        Text="Limpiar"
                                        TextColor="#19535F" />

                                    <Button
                                        Grid.Column="1"
                                        BackgroundColor="#0aa59b"
                                        Command="{Binding ApplyFiltersCommand}"
                                        CornerRadius="20"
                                        Text="Aplicar"
                                        TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>

                </AbsoluteLayout>

            </Border>
        </Grid>

    </Grid>
</ContentPage>
