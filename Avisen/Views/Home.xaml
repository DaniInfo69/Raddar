<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.Home"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    Padding="0"
    Shell.NavBarIsVisible="False">
    <!--  Eliminamos padding adicional  -->

    <Grid RowDefinitions="Auto, *">
        <!--  Encabezado  -->
        <Grid
            Grid.Row="0"
            Padding="30"
            BackgroundColor="#0aa59b">
            <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                <Label
                    FontSize="Medium"
                    HorizontalOptions="Start"
                    Text="{Binding UpdateFrequency}"
                    TextColor="White" />
                <Label
                    FontSize="Medium"
                    HorizontalOptions="End"
                    Text="{Binding SeeHour}"
                    TextColor="White" />
            </HorizontalStackLayout>
        </Grid>

        <!--  Contenido principal  -->
        <Grid Grid.Row="1">
            <Border
                Margin="0,-30,0,0"
                Padding="20"
                BackgroundColor="#f0ebdc"
                StrokeThickness="0"
                VerticalOptions="FillAndExpand">
                <!--  Permite que ocupe toda la pantalla  -->

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30,30,0,0" />
                </Border.StrokeShape>

                <ScrollView>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <Label
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                FontAttributes="Bold"
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="Ofertas"
                                TextColor="#19535F" />
                            <Picker
                                x:Name="FiltroPicker"
                                Title="Filtrar Por"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,5,10,0"
                                FontSize="16"
                                HorizontalOptions="End"
                                ItemsSource="{Binding Filters}"
                                SelectedItem="{Binding SelectedFilter}"
                                TextColor="#19535F"
                                TitleColor="Black"
                                WidthRequest="140" />
                        </Grid>

                        <!--  Lista de ofertas con scroll  -->
                        <ScrollView HeightRequest="500">
                            <CollectionView x:Name="OfertasList" ItemsSource="{Binding OfertasReales}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,15"
                                            Padding="10"
                                            BackgroundColor="White"
                                            Stroke="#19535F"
                                            StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle />
                                            </Border.StrokeShape>

                                            <Grid ColumnDefinitions="2*, 3*" RowDefinitions="Auto, Auto">
                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="3"
                                                    HorizontalOptions="Center"
                                                    Stroke="#19535F"
                                                    StrokeThickness="2"
                                                    VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle />
                                                    </Border.StrokeShape>
                                                    <Image
                                                        Aspect="AspectFill"
                                                        HeightRequest="100"
                                                        Source="{Binding ImagenUrl}" />
                                                </Border>

                                                <VerticalStackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="10"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="20"
                                                        Text="{Binding Nombre}"
                                                        TextColor="#19535F" />
                                                    <Label
                                                        FontSize="16"
                                                        Text="{Binding Descripcion}"
                                                        TextColor="#602020" />
                                                </VerticalStackLayout>

                                                <Button
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="5"
                                                    BackgroundColor="#19535F"
                                                    Clicked="OnVerOfertaClicked"
                                                    CommandParameter="{Binding}"
                                                    FontAttributes="Bold"
                                                    FontSize="18"
                                                    HorizontalOptions="Fill"
                                                    Text="Ver Oferta"
                                                    TextColor="White" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>

