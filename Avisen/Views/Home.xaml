<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.Home"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    Shell.NavBarIsVisible="False"
    Padding="0">
    <!-- Eliminamos padding adicional -->

    <Grid RowDefinitions="Auto, *">
        <!-- Encabezado -->
        <Grid BackgroundColor="#0aa59b" Grid.Row="0" Padding="30">
            <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                <Label Text="{Binding UpdateFrequency}"
                       FontSize="Medium"
                       TextColor="White"
                       HorizontalOptions="Start"/>
                <Label Text="{Binding SeeHour}"
                       FontSize="Medium"
                       TextColor="White"
                       HorizontalOptions="End"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Contenido principal -->
        <Grid Grid.Row="1">
            <Border Margin="0,-30,0,0"
                    StrokeThickness="0"
                    BackgroundColor="#f0ebdc"
                    Padding="20"
                    VerticalOptions="FillAndExpand">
                <!-- Permite que ocupe toda la pantalla -->

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30,30,0,0" />
                </Border.StrokeShape>

                <ScrollView>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                   FontAttributes="Bold"
                                   FontSize="24"
                                   Text="Ofertas"
                                   TextColor="#19535F"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,0" />
                            <Picker Grid.Row="1" Grid.Column="1"
                                    x:Name="FiltroPicker"
                                    Title="Filtrar Por"
                                    TitleColor="Black"
                                    TextColor="#19535F"
                                    FontSize="16"
                                    HorizontalOptions="End"
                                    Margin="0,5,10,0"
                                    WidthRequest="140"
                                    ItemsSource="{Binding Filters}"
                                    SelectedItem="{Binding SelectedFilter}">
                            </Picker>
                        </Grid>

                        <!-- Lista de ofertas con scroll -->
                        <ScrollView HeightRequest="500">
                            <CollectionView ItemsSource="{Binding OfertasReales}" x:Name="OfertasList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,15"
                                                Padding="10"
                                                BackgroundColor="White"
                                                Stroke="#19535F"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle />
                                            </Border.StrokeShape>

                                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="2*, 3*">
                                                <Border Grid.Row="0" Grid.Column="0"
                                                        Stroke="#19535F"
                                                        StrokeThickness="2"
                                                        Padding="3"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle />
                                                    </Border.StrokeShape>
                                                    <Image Source="{Binding ImagenUrl}"
                                                           HeightRequest="100"
                                                           Aspect="AspectFill"/>
                                                </Border>

                                                <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                                     Padding="10"
                                                                     VerticalOptions="Center">
                                                    <Label FontAttributes="Bold"
                                                           FontSize="20"
                                                           Text="{Binding Nombre}"
                                                           TextColor="#19535F"/>
                                                    <Label FontSize="16"
                                                           Text="{Binding Promocion.Descripcion}"
                                                           TextColor="#602020"/>
                                                </VerticalStackLayout>

                                                <Button Grid.Row="1" Grid.ColumnSpan="2"
                                                        BackgroundColor="#19535F"
                                                        Clicked="OnVerOfertaClicked"
                                                        CommandParameter="{Binding}"
                                                        FontAttributes="Bold"
                                                        FontSize="18"
                                                        Text="Ver Oferta"
                                                        TextColor="White"
                                                        HorizontalOptions="Fill"
                                                        Margin="5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>

