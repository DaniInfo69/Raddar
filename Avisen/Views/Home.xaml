<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Avisen.Views.Home"
             xmlns:local="clr-namespace:Avisen"
             Title="Home"
             Padding="0"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="30"
            BackgroundColor="#0aa59b">
            <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                <Label
                    FontSize="Medium"
                    HorizontalOptions="Start"
                    Text="{Binding UpdateFrequency}"
                    TextColor="White" />
                <Label
                    FontSize="Medium"
                    HorizontalOptions="End"
                    Text="{Binding SeeHour}"
                    TextColor="White" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Border
                Margin="0,-30,0,0"
                Padding="20"
                BackgroundColor="#f0ebdc"
                StrokeThickness="0"
                VerticalOptions="FillAndExpand">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30,30,0,0" />
                </Border.StrokeShape>

                <AbsoluteLayout>

                    <!-- Contenido principal -->
                    <VerticalStackLayout AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10" VerticalOptions="Center">
                            <!-- Título -->
                            <Label
                                Grid.Column="0"
                                Padding="80,0,0,0"
                                FontAttributes="Bold"
                                FontSize="24"
                                HorizontalOptions="Center"
                                Text="Ofertas"                             
                                TextColor="#19535F" />

                            <!-- Botón de Filtrar -->
                            <Button
                                Grid.Column="1"
                                Text="Filtrar"
                                FontSize="18"
                                TextColor="#19535F"
                                BackgroundColor="#d1e7dd"
                                CornerRadius="20"
                                Padding="10"
                                Clicked="OnFiltrarTapped"
                                HorizontalOptions="End">

                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="MaterialIcon"
                                        Glyph="{x:Static local:IconFont.List_alt}"
                                        Size="25"
                                        Color="#19535F" />
                                </Button.ImageSource>

                            </Button>
                        </Grid>

                        <!-- Lista estilo tarjetas -->
                        <CollectionView x:Name="OfertasList" ItemsSource="{Binding OfertasReales}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        Margin="0,0,0,10"
                                        Padding="10"
                                        BorderColor="#CCCCCC"
                                        CornerRadius="8"
                                        HasShadow="False"
                                        BackgroundColor="White">

                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">

                                            <!-- Logo o imagen -->
                                            <Image
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Source="{Binding ImagenUrl}"
                                                WidthRequest="50"
                                                HeightRequest="50"
                                                Aspect="AspectFit"
                                                Margin="0,0,10,0" />

                                            <!-- Título -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Text="{Binding Nombre}"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                TextColor="#19535F" />

                                            <!-- Subtítulo / Descripción -->
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding DescripcionEmpresa}"
                                                FontSize="14"
                                                TextColor="Gray" />

                                            <!-- Lista de promociones -->
                                            <CollectionView
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                ItemsSource="{Binding Promociones}"
                                                HeightRequest="40">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label 
                                                            Text="{Binding Nombre}" 
                                                            FontSize="14" 
                                                            TextColor="DarkBlue" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </Grid>

                                        <!-- Acción al tocar la tarjeta -->
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapCommand}"
                                                CommandParameter="{Binding}" />
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Popup del filtro encima de todo -->
                    <ContentView x:Name="FiltroPopup" IsVisible="False" BackgroundColor="Transparent" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="99">
                        <Frame x:Name="PopupFrame" BackgroundColor="White" Padding="20" CornerRadius="20" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="300" HeightRequest="250">
                            <VerticalStackLayout Spacing="15">
                                <Label Text="Filtrar por:" FontSize="18" FontAttributes="Bold" TextColor="#19535F" HorizontalOptions="Center"/>
                                <Picker
                                    x:Name="FiltroPicker"
                                    Title="Selecciona una opción"
                                    ItemsSource="{Binding Filters}"
                                    SelectedItem="{Binding SelectedFilter}"
                                    TitleColor="#19535F"
                                    TextColor="#19535F"
                                    WidthRequest="200" />
                                <Button Text="Aplicar" Clicked="OnCerrarFiltroTapped" BackgroundColor="#0aa59b" TextColor="White" CornerRadius="10"/>
                            </VerticalStackLayout>
                        </Frame>
                    </ContentView>

                </AbsoluteLayout>

            </Border>
        </Grid>

    </Grid>
</ContentPage>
