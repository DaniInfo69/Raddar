<ContentPage
    x:Class="Avisen.Views.Home"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    Title="Home"
    BackgroundColor="#FAFAFA"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Hero Section -->
            <Border
                Padding="20"
                Stroke="Black"    
                StrokeThickness="1"         
                StrokeShape="RoundRectangle 20"           
                Margin="0">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                        <GradientStop Color="#11d8cb" Offset="0.0" />
                        <GradientStop Color="#CB11D8" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>


                <VerticalStackLayout Spacing="8">
                    <!-- Título principal -->
                    <Label 
                        x:Name="lblUserName" 
                        FontSize="20" 
                        TextColor="White" 
                        FontAttributes="Bold"/>


                    <!-- Subtítulo -->
                    <Label 
                        Text="Descubre ofertas increíbles cerca de ti" 
                        FontSize="14" 
                        TextColor="White" />

                    <!-- Sección de ofertas -->
                    <Border 
                        Stroke="Black"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="Transparent"
                        Padding="12,10">
                        <!-- Padding ajustado -->

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label 
                                Style="{StaticResource MaterialIcon}"
                                Text="{x:Static local:IconFont.Pin_drop}"
                                FontSize="20"
                                TextColor="Black"
                                VerticalOptions="Center"/>

                            <Label 
                                Text="12 nuevas ofertas cerca de ti" 
                                FontSize="13" 
                                TextColor="Black"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <CollectionView
    x:Name="CategoriasList"
                Background="AntiqueWhite"
    ItemsSource="{Binding Categorias}"
    ItemsLayout="HorizontalList"
    SelectionMode="Single"
    HeightRequest="50"
    SelectedItem="{Binding CategoriaSeleccionada, Mode=TwoWay}">



                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                Padding="12,6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Stroke="Transparent"
                BackgroundColor="Transparent">

                            <Label
                    Text="{Binding Nombre}"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{Binding IsSelected, Converter={StaticResource TextColorSelectionConverter}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>



            <!-- Ofertas destacadas - Versión optimizada -->
            <StackLayout Spacing="0" Margin="0,10">
                <Label Text="🔥 Ofertas Populares" 
           FontSize="18" 
           TextColor="#19535F" 
           FontAttributes="Bold"
           Margin="15,0,0,0" />

                <CarouselView x:Name="HotOffersCarousel"
                  ItemsSource="{Binding OfertasDestacadas}"
                  HeightRequest="260"
                  PeekAreaInsets="1"
                  IsSwipeEnabled="True">

                    <CarouselView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" 
                              SnapPointsType="MandatorySingle"
                              ItemSpacing="15" />
                    </CarouselView.ItemsLayout>

                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="20" 
                       Padding="15"
                       HasShadow="True"
                       WidthRequest="320"
                       HeightRequest="240"
                       Margin="0"
                       HorizontalOptions="Center">

                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#11d8cb" Offset="0.0" />
                                        <GradientStop Color="#CB11D8" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Frame.Background>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                          ColumnDefinitions="*,Auto"
                          RowSpacing="5"
                          VerticalOptions="FillAndExpand">

                                    <!-- Imagen + Título -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" 
                                              Spacing="10" 
                                              VerticalOptions="Center">
                                        <Image Source="{Binding imagenes[0].url}" 
                                   WidthRequest="40" 
                                   HeightRequest="40" 
                                   Aspect="AspectFill" />
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding Nombre}" 
                                       FontSize="14" 
                                       TextColor="White" 
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>
                                            <Label Text="Restaurante" 
                                       FontSize="12" 
                                       TextColor="White" />
                                        </VerticalStackLayout>
                                        <Label Text="LIMITED"
                                   FontSize="10"
                                   TextColor="Black"
                                   BackgroundColor="Yellow"
                                   Padding="6,2"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"/>
                                    </HorizontalStackLayout>

                                    <!-- Descuento -->
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                               Text="50% OFF Dinner for Two"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"
                               Margin="0,5,0,0" />

                                    <!-- Descripción -->
                                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                               Text="Enjoy authentic Italian cuisine with our special dinner package"
                               FontSize="12"
                               TextColor="White"
                               MaxLines="2"
                               LineBreakMode="TailTruncation"/>

                                    <!-- Fechas/Distancia -->
                                    <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2"
                                               Spacing="15"
                                               Margin="0,5">
                                        <Label Text="⏳ 2 days left" 
                                   FontSize="12" 
                                   TextColor="White" />
                                        <Label Text="📍 0.8 miles" 
                                   FontSize="12" 
                                   TextColor="White" />
                                    </HorizontalStackLayout>

                                    <!-- Botón -->
                                    <Button Grid.Row="4" Grid.ColumnSpan="2"
                                Text="Ver oferta"
                                FontSize="12"
                                CornerRadius="10"
                                Padding="10,5"
                                BackgroundColor="White"
                                TextColor="#CB11D8"
                                HorizontalOptions="Fill"
                                Margin="0,10,0,0"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
            </StackLayout>

            <!-- Todas las ofertas -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Todas las ofertas" FontSize="18" FontAttributes="Bold" TextColor="#19535F" />
                <Button Grid.Column="1" Text="Ver todo" FontSize="14" BackgroundColor="Transparent" TextColor="#0aa59b" />
            </Grid>

            <CollectionView x:Name="OfertasList" ItemsSource="{Binding OfertasReales}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15" Margin="0,0,0,10" BackgroundColor="White" BorderColor="#e0e0e0" CornerRadius="10" HasShadow="True">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                <Image Grid.RowSpan="3" Grid.Column="0" Source="{Binding imagenes[0].url}" WidthRequest="80" HeightRequest="80" Aspect="AspectFill" Margin="0,0,15,0" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" TextColor="#19535F" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding VigenciaFin, StringFormat='Válido hasta {0:d}'}" FontSize="12" TextColor="#0aa59b" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Tipo}" FontSize="12" TextColor="#777" />
                            </Grid>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapCommand}" CommandParameter="{Binding}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>