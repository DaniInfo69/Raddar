<ContentPage
    x:Class="Avisen.Views.Home"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Avisen.Controls"
    xmlns:local="clr-namespace:Avisen"
    xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
    xmlns:uranium="clr-namespace:UraniumUI;assembly=UraniumUI"
    Title="Home"
    BackgroundColor="#FAFAFA"
    Shell.NavBarIsVisible="False">


    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="PaginationLabel" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#666" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Margin" Value="5,0" />
            </Style>

            <!--  Estilo OutlinedButton  -->
            <Style x:Key="OutlinedButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#0aa59b" />
                <Setter Property="BorderColor" Value="#0aa59b" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,5" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!--  Hero Section  -->
                <Border
                    Margin="0"
                    Padding="20"
                    Stroke="Black"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                            <GradientStop Offset="0.0" Color="#11d8cb" />
                            <GradientStop Offset="1.0" Color="#CB11D8" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <VerticalStackLayout Spacing="8">
                        <!--  Título principal  -->
                        <Label
                            x:Name="lblUserName"
                            FontAttributes="Bold"
                            FontSize="20"
                            TextColor="White" />

                        <!--  Subtítulo  -->
                        <Label
                            FontSize="14"
                            Text="Descubre ofertas increíbles cerca de ti"
                            TextColor="White" />

                        <!--  Sección de ofertas  -->
                        <Border
                            Padding="12,10"
                            BackgroundColor="Transparent"
                            Stroke="Black"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label
                                    FontSize="20"
                                    Style="{StaticResource MaterialIcon}"
                                    Text="{x:Static local:IconFont.Pin_drop}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />

                                <Label
                                    FontSize="13"
                                    Text="12 nuevas ofertas cerca de ti"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!--  Categorías  -->
                <CollectionView
                    x:Name="CategoriasList"
                    BackgroundColor="AntiqueWhite"
                    HeightRequest="50"
                    ItemsLayout="HorizontalList"
                    ItemsSource="{Binding Categorias}"
                    SelectedItem="{Binding CategoriaSeleccionada, Mode=TwoWay}"
                    SelectionMode="Single">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12,6"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1">

                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Source={RelativeSource Mode=TemplatedParent}, Path=IsSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#0aa59b" />
                                        <Setter Property="Stroke" Value="#0aa59b" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="{Binding Nombre}"
                                    TextColor="Black"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Source={RelativeSource Mode=TemplatedParent}, Path=IsSelected}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding Source={RelativeSource Mode=TemplatedParent}, Path=IsSelected}"
                                            TargetType="Label"
                                            Value="False">
                                            <Setter Property="TextColor" Value="#0aa59b" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>


                </CollectionView>

                <!--  Ofertas destacadas  -->
                <StackLayout Margin="0,10" Spacing="0">
                    <Label
                        Margin="15,0,0,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="🔥 Ofertas Populares"
                        TextColor="#19535F" />

                    <CarouselView
                        x:Name="HotOffersCarousel"
                        HeightRequest="300"
                        HorizontalOptions="FillAndExpand"
                        IsSwipeEnabled="True"
                        ItemsSource="{Binding OfertasDestacadas}"
                        PeekAreaInsets="20">

                        <CarouselView.ItemsLayout>
                            <LinearItemsLayout
                                ItemSpacing="15"
                                Orientation="Horizontal"
                                SnapPointsType="MandatorySingle" />
                        </CarouselView.ItemsLayout>

                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Margin="10"
                                    Padding="12"
                                    CornerRadius="20"
                                    HasShadow="True"
                                    HorizontalOptions="FillAndExpand">

                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0.0" Color="#11d8cb" />
                                            <GradientStop Offset="1.0" Color="#CB11D8" />
                                        </LinearGradientBrush>
                                    </Frame.Background>

                                    <Grid
                                        ColumnDefinitions="Auto, *"
                                        RowDefinitions="Auto, Auto, Auto, Auto"
                                        RowSpacing="6"
                                        VerticalOptions="FillAndExpand">

                                        <!--  Imagen  -->
                                        <Grid
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            HeightRequest="80"
                                            HorizontalOptions="Start"
                                            WidthRequest="80">
                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="80"
                                                HorizontalOptions="Center"
                                                Source="{Binding imagenes[0].url}"
                                                VerticalOptions="Center"
                                                WidthRequest="80" />
                                        </Grid>

                                        <!--  Título + Empresa + Tipo  -->
                                        <VerticalStackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <!--  Nombre promoción  -->
                                            <Label
                                                Padding="10"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                Text="{Binding Nombre}"
                                                TextColor="White" />

                                            <!--  Nombre empresa (nuevo)  -->
                                            <Label
                                                Padding="10,0,0,0"
                                                FontSize="13"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding NombreEmpresa}"
                                                TextColor="#F1F1F1" />

                                            <!--  Tipo  -->
                                            <Label
                                                Padding="10,0,0,0"
                                                FontSize="13"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding Tipo}"
                                                TextColor="White" />
                                        </VerticalStackLayout>

                                        <!--  Descripción  -->
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Padding="10,0,0,0"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding Descripcion}"
                                            TextColor="White" />

                                        <!--  Fechas / distancia  -->
                                        <HorizontalStackLayout
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Margin="0,5"
                                            Spacing="12"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                Text="{Binding DiasRestantesTexto}"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="12"
                                                Opacity="0.9"
                                                Text="{Binding VigenciaFin, StringFormat='⏳ válido hasta {0:d}'}"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="12"
                                                Text="📍 Distancia N/A"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!--  Botón  -->
                                        <Button
                                            Grid.Row="3"
                                            Grid.ColumnSpan="2"
                                            Margin="0,8,0,0"
                                            Padding="10,6"
                                            BackgroundColor="White"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapCommand}"
                                            CommandParameter="{Binding}"
                                            CornerRadius="10"
                                            FontSize="12"
                                            HorizontalOptions="Fill"
                                            Text="Ver oferta"
                                            TextColor="#CB11D8" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>





                    </CarouselView>
                </StackLayout>

                <!--  Todas las ofertas  -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Todas las ofertas"
                        TextColor="#19535F" />
                </Grid>

                <!--  Lista de ofertas con paginación  -->
                <CollectionView
                    x:Name="OfertasList"
                    ItemsSource="{Binding OfertasReales}"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="10"
                            VerticalOptions="Center">
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="No hay ofertas disponibles" />
                            <Button
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Text="Recargar" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                Margin="0,0,0,10"
                                Padding="15"
                                BackgroundColor="White"
                                BorderColor="#e0e0e0"
                                CornerRadius="10"
                                HasShadow="True">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <!--  Imagen  -->
                                    <Image
                                        Grid.RowSpan="4"
                                        Grid.Column="0"
                                        Margin="0,0,15,0"
                                        Aspect="AspectFill"
                                        HeightRequest="80"
                                        WidthRequest="80">
                                        <Image.Source>
                                            <UriImageSource
                                                CacheValidity="1:00:00:00"
                                                CachingEnabled="True"
                                                Uri="{Binding imagenes[0].url}" />
                                        </Image.Source>
                                    </Image>

                                    <!--  Nombre promoción  -->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding Nombre}"
                                        TextColor="#19535F" />

                                    <!--  Nombre empresa (nuevo)  -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="{Binding NombreEmpresa}"
                                        TextColor="#555" />

                                    <!--  Vigencia fin  -->
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding VigenciaFin, StringFormat='Válido hasta {0:d}'}"
                                        TextColor="#0aa59b" />

                                    <!--  Tipo  -->
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding Tipo}"
                                        TextColor="#777" />
                                </Grid>

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TapCommand}" CommandParameter="{Binding}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <Frame
                    Margin="0,20"
                    Padding="10"
                    BackgroundColor="#FAFAFA"
                    BorderColor="#EEEEEE"
                    CornerRadius="10"
                    HasShadow="True">

                    <HorizontalStackLayout
                        x:Name="PaginationLayout"
                        HorizontalOptions="Center"
                        Spacing="5"
                        VerticalOptions="Center">

                        <!--  Loading indicator alternativo  -->
                        <ActivityIndicator
                            HorizontalOptions="Center"
                            IsRunning="{Binding IsLoading}"
                            IsVisible="{Binding IsLoading}"
                            VerticalOptions="Center"
                            Color="#0aa59b" />
                    </HorizontalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingOverlay x:Name="LoadingView" IsVisible="{Binding IsLoading}" />
    </Grid>

</ContentPage>