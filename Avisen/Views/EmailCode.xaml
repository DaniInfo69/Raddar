<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.EmailCode"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    xmlns:sharpnado="http://sharpnado.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="EmailCode"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions=".3*, .7*">
                <Image Aspect="AspectFill" Source="fondo3.png" />
                <Grid BackgroundColor="#e4e4e4" Opacity=".85" />
                <Grid ColumnDefinitions="*,*">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="150"
                        Source="logo.png" />
                </Grid>

                <!--  Contenido principal  -->
                <Grid Grid.Row="1">
                    <RoundRectangle
                        Margin="-5,-30,-5,-2"
                        CornerRadius="30,30,0,0"
                        Fill="#fdfefe" />
                    <VerticalStackLayout Spacing="20" VerticalOptions="Start">
                        <Label
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            Text="Introduce el codigó de seguridad enviado a tu correo"
                            TextColor="#A3A3A4"
                            VerticalTextAlignment="Justify" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Border
                                BackgroundColor="White"
                                HeightRequest="50"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 25"
                                StrokeThickness="2"
                                WidthRequest="50">
                                <Entry
                                    x:Name="Entry1"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    TextChanged="OnEntryTextChanged"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="White"
                                HeightRequest="50"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 25"
                                StrokeThickness="2"
                                WidthRequest="50">
                                <Entry
                                    x:Name="Entry2"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    TextChanged="OnEntryTextChanged"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="White"
                                HeightRequest="50"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 25"
                                StrokeThickness="2"
                                WidthRequest="50">
                                <Entry
                                    x:Name="Entry3"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    TextChanged="OnEntryTextChanged"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="White"
                                HeightRequest="50"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 25"
                                StrokeThickness="2"
                                WidthRequest="50">
                                <Entry
                                    x:Name="Entry4"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    TextChanged="OnEntryTextChanged"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="White"
                                HeightRequest="50"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 25"
                                StrokeThickness="2"
                                WidthRequest="50">
                                <Entry
                                    x:Name="Entry5"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    TextChanged="OnEntryTextChanged"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="White"
                                HeightRequest="50"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 25"
                                StrokeThickness="2"
                                WidthRequest="50">
                                <Entry
                                    x:Name="Entry6"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    TextChanged="OnEntryTextChanged"
                                    VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*, *">
                            <Button
                                x:Name="ResendEmail"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,20,0,0"
                                BackgroundColor="#11d8cb"
                                Clicked="ResendEmail_Clicked"
                                CornerRadius="30"
                                FontSize="20"
                                HeightRequest="60"
                                Text="Reenviar correo"
                                TextColor="Black"
                                WidthRequest="170" />
                            <Button
                                x:Name="NewPassword"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,20,0,0"
                                BackgroundColor="#11d8cb"
                                Clicked="NewPassword_Clicked"
                                CornerRadius="30"
                                FontSize="20"
                                HeightRequest="60"
                                Text="Aceptar"
                                TextColor="Black"
                                WidthRequest="170" />


                        </Grid>

                        <Button
                            x:Name="GoBack"
                            Margin="0,20,0,0"
                            BackgroundColor="#11d8cb"
                            Clicked="GoBack_Clicked"
                            CornerRadius="30"
                            FontSize="20"
                            HeightRequest="60"
                            Text="Retroceder"
                            TextColor="Black"
                            WidthRequest="350" />

                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </ScrollView>
        <Grid
            x:Name="Overlay"
            BackgroundColor="#30000000"
            IsVisible="False">
            <sharpnado:MaterialFrame
                x:Name="Popupalert"
                CornerRadius="30"
                HeightRequest="200"
                HorizontalOptions="Center"
                MaterialBlurStyle="Light"
                MaterialTheme="AcrylicBlur"
                VerticalOptions="Center"
                WidthRequest="180">
                <VerticalStackLayout Padding="20" Spacing="15">
                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        HeightRequest="80"
                        IsRunning="False"
                        IsVisible="False"
                        WidthRequest="80"
                        Color="Black" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="17"
                        HorizontalOptions="Center"
                        Text="Cargando"
                        TextColor="Black" />
                </VerticalStackLayout>
            </sharpnado:MaterialFrame>
        </Grid>
    </Grid>
</ContentPage>