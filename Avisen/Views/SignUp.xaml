<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.SignUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    xmlns:sharpnado="http://sharpnado.com"
    Title="SignUp"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions=".3*, .7*">
                <Image Aspect="AspectFill" Source="fondo3.png" />
                <Grid BackgroundColor="#e4e4e4" Opacity=".85" />
                <Grid ColumnDefinitions="*,*">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="150"
                        Source="logo.png" />
                </Grid>

                <!--  Contenido principal  -->
                <Grid Grid.Row="1">
                    <RoundRectangle
                        Margin="-5,-30,-5,-2"
                        CornerRadius="30,30,0,0"
                        Fill="#fdfefe" />
                    <VerticalStackLayout>
                        <Label
                            x:Name="Message"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            LineHeight=".9"
                            Text="Crea tu cuenta!"
                            TextColor="#A3A3A4" />

                        <!--  Campo de  -->
                        <Grid Margin="0,30,0,0" ColumnDefinitions=".2*, .8*">
                            <Border
                                BackgroundColor="#f0f3f4"
                                HeightRequest="60"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 30,30,30,30"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="60">
                                <Label
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource MaterialIcon}"
                                    Text="{x:Static local:IconFont.Person}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Border>
                            <Entry
                                x:Name="UserName"
                                Grid.Column="1"
                                BackgroundColor="#fdfefe"
                                FontSize="16"
                                HeightRequest="60"
                                MaxLength="90"
                                Placeholder="Usuario"
                                TextChanged="UserName_TextChanged"
                                TextColor="Black"
                                VerticalOptions="Center"
                                WidthRequest="300" />
                        </Grid>

                        <!--  Campo de EMAIL  -->
                        <Grid Margin="0,30,0,0" ColumnDefinitions=".2*, .8*">
                            <Border
                                BackgroundColor="#f0f3f4"
                                HeightRequest="60"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 30,30,30,30"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="60">
                                <Label
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource MaterialIcon}"
                                    Text="{x:Static local:IconFont.Mail}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Border>
                            <Entry
                                x:Name="Email"
                                Grid.Column="1"
                                BackgroundColor="#fdfefe"
                                FontSize="16"
                                HeightRequest="60"
                                MaxLength="60"
                                Placeholder="Correo"
                                TextChanged="Email_TextChanged"
                                TextColor="Black"
                                VerticalOptions="Center"
                                WidthRequest="300" />
                        </Grid>

                        <!--  Campo Contraseña  -->
                        <Grid Margin="0,30,0,0" ColumnDefinitions=".2*, .8*">
                            <Border
                                BackgroundColor="#f0f3f4"
                                HeightRequest="60"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 30,30,30,30"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="60">
                                <Label
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource MaterialIcon}"
                                    Text="{x:Static local:IconFont.Lock}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Border>
                            <Entry
                                x:Name="Password"
                                Grid.Column="1"
                                BackgroundColor="#fdfefe"
                                FontSize="16"
                                HeightRequest="60"
                                IsPassword="true"
                                MaxLength="20"
                                Placeholder="Contraseña"
                                TextChanged="Password_TextChanged"
                                TextColor="Black"
                                VerticalOptions="Center"
                                WidthRequest="300" />
                        </Grid>

                        <!--  Campo Contraseña 2  -->
                        <Grid Margin="0,30,0,0" ColumnDefinitions=".2*, .8*">
                            <Border
                                BackgroundColor="#f0f3f4"
                                HeightRequest="60"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 30,30,30,30"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="60">
                                <Label
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource MaterialIcon}"
                                    Text="{x:Static local:IconFont.Lock}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Border>
                            <Entry
                                x:Name="Password2"
                                Grid.Column="1"
                                BackgroundColor="#fdfefe"
                                FontSize="16"
                                HeightRequest="60"
                                IsPassword="true"
                                MaxLength="20"
                                Placeholder="Repite la Contraseña"
                                TextChanged="Password2_TextChanged"
                                TextColor="Black"
                                VerticalOptions="Center"
                                WidthRequest="300" />
                        </Grid>

                        <Button
                            x:Name="CreateAccount"
                            Margin="0,20,0,0"
                            BackgroundColor="#11d8cb"
                            Clicked="CreateAccount_Clicked"
                            CornerRadius="30"
                            FontSize="20"
                            HeightRequest="60"
                            IsEnabled="True"
                            Text="Crear cuenta"
                            TextColor="Black"
                            WidthRequest="350" />
                        <Label
                            Margin="0,20,0,-10"
                            FontSize="40"
                            HorizontalOptions="Center"
                            Style="{StaticResource MaterialIcon}"
                            Text="{x:Static local:IconFont.Arrow_back}"
                            TextColor="#dc5a4b">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Back_Clicked" />
                            </Label.GestureRecognizers>
                        </Label>

                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </ScrollView>
        <ContentView
            x:Name="CustomAlert"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            InputTransparent="False"
            IsVisible="False">
            <Grid BackgroundColor="#30000000">
                <sharpnado:MaterialFrame
                    x:Name="Popupalert"
                    CornerRadius="30"
                    HeightRequest="325"
                    HorizontalOptions="Center"
                    MaterialBlurStyle="Light"
                    MaterialTheme="AcrylicBlur"
                    VerticalOptions="Center"
                    WidthRequest="400">
                    <VerticalStackLayout Padding="20" Spacing="15">
                        <Label
                            x:Name="AfterCreationMessage"
                            FontAttributes="Bold"
                            FontSize="17"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Justify"
                            TextColor="#19535F" />
                        <Button
                            BackgroundColor="#11d8cb"
                            Clicked="CloseCustomAlert"
                            CornerRadius="30"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Aceptar"
                            TextColor="White" />
                    </VerticalStackLayout>
                </sharpnado:MaterialFrame>
            </Grid>
        </ContentView>

    </Grid>
</ContentPage>