<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.PromocionDetallesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    xmlns:skia="[skia ]clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    Title="Detalles de la Promoción"
    BackgroundColor="#F5EBDC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Button
                BackgroundColor="Transparent"
                Clicked="CerrarModal"
                FontFamily="MaterialIcon"
                FontSize="30"
                HorizontalOptions="Start"
                Text="{x:Static local:IconFont.Arrow_back}"
                TextColor="#0aa59b" />

            <!--  Tarjeta completa  -->
            <Border
                Padding="0"
                BackgroundColor="White"
                HeightRequest="620"
                Stroke="#19535F"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="2">

                <!--  GRID PRINCIPAL  -->
                <Grid RowDefinitions="Auto, *, Auto">

                    <!--  Header  -->
                    <Frame
                        Grid.Row="0"
                        Margin="10,20,10,0"
                        Padding="10"
                        BackgroundColor="White"
                        BorderColor="#CCCCCC"
                        CornerRadius="8"
                        HasShadow="False">

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                            <Image
                                x:Name="PromocionImagen"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Aspect="AspectFit"
                                HeightRequest="50"
                                Source="{Binding ImagenUrl}"
                                WidthRequest="50" />
                            <Label
                                x:Name="NombreNegocioLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#19535F" />
                            <Label
                                x:Name="DescripcionNegocioLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="14"
                                TextColor="Gray" />
                        </Grid>

                    </Frame>

                    <!--  CONTENIDO PRINCIPAL  -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Padding="20"
                        Spacing="15">

                        <BoxView
                            HeightRequest="2"
                            HorizontalOptions="FillAndExpand"
                            Color="Black" />
                        <Label x:Name="PromocionesLabel" />
                        <BoxView
                            HeightRequest="2"
                            HorizontalOptions="FillAndExpand"
                            Color="Black" />

                        <!--  Fechas  -->
                        <Grid Padding="0,10" ColumnDefinitions="*,*">
                            <VerticalStackLayout Padding="10,0,0,0">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Publicada el:"
                                    TextColor="#19535F" />
                                <Label x:Name="VigenciaLabel" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Padding="10,0,0,0">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Finaliza el:"
                                    TextColor="#19535F" />
                                <Label x:Name="VigenciaLabel2" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView
                            HeightRequest="2"
                            HorizontalOptions="FillAndExpand"
                            Color="Black" />

                    </VerticalStackLayout>

                    <!--  BOTONES AL FINAL  -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,0,0,20"
                        Padding="20"
                        ColumnDefinitions="*,*"
                        VerticalOptions="End">


                        <Button
                            Grid.Column="1"
                            BackgroundColor="#19535F"
                            CornerRadius="20"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="50"
                            HorizontalOptions="End"
                            Text="Ir a la oferta"
                            TextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="240" />
                    </Grid>

                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
