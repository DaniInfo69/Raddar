<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.PromocionDetallesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    Title="Detalles de la Promoción"
    BackgroundColor="#F7F8F7"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="18">

            <!--  Back button (igual que antes)  -->
            <Button
                BackgroundColor="Transparent"
                Clicked="CerrarModal"
                FontFamily="MaterialIcon"
                FontSize="30"
                HorizontalOptions="Start"
                Text="{x:Static local:IconFont.Arrow_back}"
                TextColor="#0aa59b" />

            <!--  Card principal  -->
            <Border
                Padding="0"
                BackgroundColor="#FFFFFF"
                HorizontalOptions="Fill"
                Stroke="#E6E6E6"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">

                <VerticalStackLayout Padding="14" Spacing="12">

                    <!--  Imagen banner (sin IsClippedToBounds)  -->
                    <Border
                        Padding="0"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <Image
                            x:Name="ImageBanner"
                            Aspect="AspectFill"
                            HeightRequest="200"
                            Source="{Binding imagenes[0].url}" />
                    </Border>

                    <!--  Título y subtítulo  -->
                    <Label
                        x:Name="TituloPromocion"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding Nombre}"
                        TextColor="#1E4F4E" />

                    <Label
                        x:Name="Subtitulo"
                        FontSize="14"
                        Text="{Binding NombreEmpresa}"
                        TextColor="Gray" />

                    <!--  Descripción: ahora hace wrap y tiene margen inferior para separar del precio  -->
                    <Label
                        x:Name="DescripcionText"
                        Margin="0,0,0,8"
                        FontSize="14"
                        LineBreakMode="WordWrap"
                        Text="{Binding Descripcion}"
                        TextColor="#5a2a2a" />

                    <!--  Precio y tipo (badge) - ahora alineados a la izquierda y juntos  -->
                    <Grid
                        Margin="0,6,0,0"
                        ColumnDefinitions="Auto, Auto, *"
                        VerticalOptions="Center">
                        <!--  Columna 0: Precio  -->
                        <VerticalStackLayout
                            Grid.Column="0"
                            HorizontalOptions="Start"
                            Spacing="2">
                            <Label
                                FontSize="12"
                                Text="Precio"
                                TextColor="Gray" />
                            <Label
                                x:Name="PrecioLabel"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding Precio, StringFormat='$ {0} mxn'}"
                                TextColor="#1E4F4E" />
                        </VerticalStackLayout>

                        <!--  Columna 1: Tipo (cerca del precio, con pequeño margen)  -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="95,0,0,0"
                            HorizontalOptions="Start"
                            Spacing="2">
                            <Label
                                FontSize="12"
                                HorizontalOptions="Start"
                                Text="Tipo"
                                TextColor="Gray" />
                            <Border
                                x:Name="TipoFrame"
                                Padding="10,4"
                                BackgroundColor="#FFF0F0"
                                HorizontalOptions="Start"
                                Stroke="#F4C2C2"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                                <Label
                                    x:Name="TipoBadge"
                                    FontSize="12"
                                    Text="{Binding Tipo}"
                                    TextColor="#C94A4A" />
                            </Border>
                        </VerticalStackLayout>

                        <!--  Columna 2: espacio flexible para evitar que se empuje a la derecha  -->

                    </Grid>

                    <Grid Padding="0,6" ColumnDefinitions="*,*">
                        <VerticalStackLayout>
                            <Label
                                FontSize="12"
                                Text="Publicada:"
                                TextColor="Gray" />
                            <Label
                                x:Name="VigenciaLabel"
                                FontSize="14"
                                TextColor="#19535F" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontSize="12"
                                Text="Finaliza:"
                                TextColor="Gray" />
                            <Label
                                x:Name="VigenciaLabel2"
                                FontSize="14"
                                TextColor="#19535F" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E6E6E6" />

                    <!--  QR section: todo envuelto en un borde clickeable  -->
                    <VerticalStackLayout Spacing="8">
                        <Border
                            x:Name="QrBorder"
                            Padding="10"
                            BackgroundColor="Transparent"
                            HeightRequest="50"
                            Stroke="#E6E6E6"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Grid
                                ColumnDefinitions="*, Auto"
                                RowDefinitions="Auto"
                                VerticalOptions="Center">

                                <!--  Texto QR alineado verticalmente al centro  -->
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    HorizontalOptions="Start"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        FontSize="14"
                                        Text="QR Code"
                                        TextColor="#333"
                                        VerticalOptions="Center" />
                                </VerticalStackLayout>

                                <!--  Flecha hacia abajo: centrada vertical y horizontalmente respecto al texto  -->
                                <Button
                                    x:Name="BtnToggleQr"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Clicked="BtnToggleQr_Clicked"
                                    FontSize="20"
                                    HeightRequest="36"
                                    HorizontalOptions="Center"
                                    Text="▾"
                                    VerticalOptions="Center"
                                    WidthRequest="36" />
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="QrBorder_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!--  Mensaje si no hay QR  -->
                        <Label
                            x:Name="LblNoQr"
                            FontSize="12"
                            IsVisible="False"
                            Text="No hay QR disponible para esta promoción."
                            TextColor="Gray" />

                        <!--  Contenedor del QR (oculto por defecto)  -->
                        <Border
                            x:Name="QrContainer"
                            Padding="10"
                            BackgroundColor="White"
                            HorizontalOptions="Center"
                            IsVisible="False"
                            Stroke="#0aa59b"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="2">
                            <Image
                                x:Name="QrImage"
                                Aspect="AspectFit"
                                HeightRequest="200"
                                WidthRequest="200" />
                        </Border>
                    </VerticalStackLayout>

                    <!--  Footer con corazón + botón Ir a la oferta  -->
                    <Grid
                        Padding="0,8,0,0"
                        ColumnDefinitions="60, *"
                        VerticalOptions="End">
                        <!--  Corazón (tu Lottie)  -->
                        <skia:SKLottieView
                            x:Name="HeartAnimation"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            IsAnimationEnabled="False"
                            Progress="1"
                            RepeatMode="Restart"
                            Scale="1.5"
                            Source="heart.json">
                            <skia:SKLottieView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHeartTapped" />
                            </skia:SKLottieView.GestureRecognizers>
                        </skia:SKLottieView>

                        <!--  Botón "Ir a la oferta" (mantenido como está)  -->
                        <Button
                            Grid.Column="1"
                            BackgroundColor="#6C46F6"
                            Clicked="IrAOfertaClicked"
                            CornerRadius="20"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="44"
                            HorizontalOptions="End"
                            Text="Ir a la oferta"
                            TextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="240" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
