<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.PromocionDetallesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia ="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    xmlns:local="clr-namespace:Avisen"
    Title="Detalles de la Promoción"
    BackgroundColor="#F5EBDC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Button
                Text="{x:Static local:IconFont.Arrow_back}"
                FontSize="30"
                HorizontalOptions="Start"
                BackgroundColor="Transparent"
                TextColor="#0aa59b"
                FontFamily="MaterialIcon"
                Clicked="CerrarModal"/>

            <!-- Tarjeta completa -->
            <Border
                BackgroundColor="White"
                Stroke="#19535F"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 20"
                Padding="0"
                HeightRequest="620">

                <!-- GRID PRINCIPAL -->
                <Grid RowDefinitions="Auto, *, Auto">

                    <!-- Header -->
                    <Frame
                        Margin="10,20,10,0"
                        Padding="10"
                        BorderColor="#CCCCCC"
                        CornerRadius="8"
                        HasShadow="False"
                        BackgroundColor="White"
                        Grid.Row="0">

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                            <Image
                                x:Name="PromocionImagen"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Source="{Binding ImagenUrl}"
                                WidthRequest="50"
                                HeightRequest="50"
                                Aspect="AspectFit"
                                Margin="0,0,10,0" />
                            <Label
                                x:Name="NombreNegocioLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#19535F" />
                            <Label
                                x:Name="DescripcionNegocioLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="14"
                                TextColor="Gray" />
                        </Grid>

                    </Frame>

                    <!-- CONTENIDO PRINCIPAL -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Padding="20"
                        Spacing="15">

                        <BoxView HeightRequest="2" Color="Black" HorizontalOptions="FillAndExpand" />
                        <Label x:Name="PromocionesLabel" />
                        <BoxView HeightRequest="2" Color="Black" HorizontalOptions="FillAndExpand" />

                        <!-- Fechas -->
                        <Grid ColumnDefinitions="*,*" Padding="0,10">
                            <VerticalStackLayout Padding="10,0,0,0">
                                <Label Text="Publicada el:" FontAttributes="Bold" TextColor="#19535F" FontSize="16" />
                                <Label x:Name="VigenciaLabel"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Padding="10,0,0,0">
                                <Label Text="Finaliza el:" FontAttributes="Bold" TextColor="#19535F" FontSize="16" />
                                <Label x:Name="VigenciaLabel2"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="2" Color="Black" HorizontalOptions="FillAndExpand" />

                    </VerticalStackLayout>

                    <!-- BOTONES AL FINAL -->
                    <Grid
                        Grid.Row="2"
                        ColumnDefinitions="*,*"
                        Padding="20"
                        VerticalOptions="End"
                        Margin="0,0,0,20">


                        <Button
                            Text="Ir a la oferta"
                            Grid.Column="1"
                            BackgroundColor="#19535F"
                            TextColor="White"
                            CornerRadius="20"
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            HeightRequest="50"
                            WidthRequest="240"/>
                    </Grid>

                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
