<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avisen.Views.PromocionDetallesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Avisen"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    Title="Detalles de la Promoción"
    BackgroundColor="#fdfefe"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!--  Botón de volver  -->
            <Button
                BackgroundColor="Transparent"
                Clicked="CerrarModal"
                FontFamily="MaterialIcon"
                FontSize="30"
                HorizontalOptions="Start"
                Text="{x:Static local:IconFont.Arrow_back}"
                TextColor="#0aa59b" />

            <!--  Tarjeta principal  -->
            <Border
                Padding="0"
                BackgroundColor="#F5EBDC"
                Stroke="#19535F"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="2">

                <Grid RowDefinitions="Auto, *, Auto">

                    <!--  Header con imagen y nombre empresa  -->
                    <Border
                        Grid.Row="0"
                        Margin="10,20,10,0"
                        Padding="10"
                        Stroke="#CCCCCC"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="2">
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                            <Border
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                HeightRequest="80"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 15"
                                WidthRequest="80">
                                <Image
                                    x:Name="ImageOffer"
                                    Aspect="AspectFill"
                                    Source="{Binding imagenes[0].url}" />
                            </Border>

                            <Label
                                x:Name="NombreNegocio"
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding NombreEmpresa}"
                                TextColor="#19535F" />

                            <Label
                                x:Name="DescripcionNegocio"
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding DescripcionEmpresa}"
                                TextColor="Gray" />
                        </Grid>
                    </Border>

                    <!--  Contenido principal  -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Padding="20"
                        Spacing="15">

                        <!--  Nombre, descripción, precio y tipo  -->
                        <Label x:Name="PromocionesLabel" />

                        <BoxView
                            HeightRequest="2"
                            HorizontalOptions="FillAndExpand"
                            Color="Gray" />

                        <Grid Padding="0,10" ColumnDefinitions="*,*">
                            <VerticalStackLayout>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Publicada el:"
                                    TextColor="#19535F" />
                                <Label
                                    x:Name="VigenciaLabel"
                                    FontSize="16"
                                    TextColor="#19535F" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Finaliza el:"
                                    TextColor="#19535F" />
                                <Label
                                    x:Name="VigenciaLabel2"
                                    FontSize="16"
                                    TextColor="#19535F" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView
                            HeightRequest="2"
                            HorizontalOptions="FillAndExpand"
                            Color="Gray" />

                        <!--  QR Code  -->
                        <Border
                            Padding="10"
                            BackgroundColor="White"
                            HorizontalOptions="Center"
                            Stroke="#0aa59b"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="2"
                            VerticalOptions="Center">
                            <Image
                                x:Name="QrImage"
                                Aspect="AspectFit"
                                HeightRequest="200"
                                WidthRequest="200" />
                        </Border>

                    </VerticalStackLayout>

                    <!--  Botones al final  -->
                    <Grid
                        Grid.Row="2"
                        Padding="20"
                        ColumnDefinitions="65,*"
                        VerticalOptions="End">
                        <skia:SKLottieView
                            x:Name="HeartAnimation"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            IsAnimationEnabled="False"
                            Progress="1"
                            RepeatMode="Restart"
                            Scale="1.5"
                            Source="heart.json">
                            <skia:SKLottieView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHeartTapped" />
                            </skia:SKLottieView.GestureRecognizers>
                        </skia:SKLottieView>

                        <Button
                            Grid.Column="1"
                            BackgroundColor="#19535F"
                            Clicked="IrAOfertaClicked"
                            CornerRadius="20"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            Text="Ir a la oferta"
                            TextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="240" />
                    </Grid>

                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>